# MediBot API: FastAPI + the in-memory catalog (~2.1 GB RSS) + Tesseract for bill photos.
# Data is NOT baked in: data/ is mounted read-mostly from the host (see docker-compose.yml).
FROM python:3.14-slim

RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-eng curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt httptools==0.9.0 uvloop==0.23.0
COPY backend/medibot /app/backend/medibot

ENV PYTHONPATH=/app/backend PYTHONUNBUFFERED=1 MEDIBOT_LIVE_PRICES=on
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 CMD curl -fs http://localhost:8000/health || exit 1
CMD ["uvicorn", "medibot.api.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers", "--forwarded-allow-ips", "*"]
